# Snap2Learn AI Backend Environment Variables

# Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Supabase Managed Database Configuration (Optional for persistent multi-device auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Server Upload Constraints
MAX_UPLOAD_SIZE_MB=10

# Server Port
PORT=8000
